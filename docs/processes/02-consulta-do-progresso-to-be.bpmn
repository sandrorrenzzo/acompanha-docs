<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P2ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.0.0">
  <bpmn:collaboration id="Collaboration_P2ToBe">
    <bpmn:participant id="Participant_P2ToBe" name="2. Consulta do progresso pelo responsável (TO-BE)" processRef="Process_P2ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P2ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P2ToBe">
      <bpmn:lane id="P2ToBe_Lane_R" name="Responsável">
        <bpmn:flowNodeRef>P2ToBe_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2ToBe_entra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2ToBe_quer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2ToBe_infsemana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2ToBe_le</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2ToBe_atenc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2ToBe_age</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2ToBe_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2ToBe_emdia</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2ToBe_Lane_S" name="Sistema Acompanha">
        <bpmn:flowNodeRef>P2ToBe_semana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2ToBe_monta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2ToBe_Lane_P" name="Professora">
        <bpmn:flowNodeRef>P2ToBe_periodo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2ToBe_obs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2ToBe_obsfim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2ToBe_ini" name="Quer saber como o filho está">
      <bpmn:outgoing>Flow_P2ToBe_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P2ToBe_entra" name="Entra no sistema">
      <bpmn:incoming>Flow_P2ToBe_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2ToBe_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P2ToBe_semana" name="Mostra a semana do filho">
      <bpmn:incoming>Flow_P2ToBe_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P2ToBe_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P2ToBe_quer" name="Quer ver o período?">
      <bpmn:incoming>Flow_P2ToBe_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P2ToBe_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_P2ToBe_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P2ToBe_infsemana" name="Informado sobre a semana">
      <bpmn:incoming>Flow_P2ToBe_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P2ToBe_monta" name="Monta o relatório do período">
      <bpmn:incoming>Flow_P2ToBe_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P2ToBe_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P2ToBe_le" name="Lê o relatório">
      <bpmn:incoming>Flow_P2ToBe_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P2ToBe_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P2ToBe_atenc" name="Alguma matéria precisa de atenção?">
      <bpmn:incoming>Flow_P2ToBe_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P2ToBe_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_P2ToBe_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="P2ToBe_age" name="Ajuda em casa ou conversa com a professora">
      <bpmn:incoming>Flow_P2ToBe_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P2ToBe_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="P2ToBe_fim" name="Família age sobre a dificuldade">
      <bpmn:incoming>Flow_P2ToBe_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P2ToBe_emdia" name="Informado, filho em dia">
      <bpmn:incoming>Flow_P2ToBe_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P2ToBe_periodo" name="Fim do mês ou do bimestre">
      <bpmn:outgoing>Flow_P2ToBe_11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_P2ToBe_periodo" />
    </bpmn:startEvent>
    <bpmn:userTask id="P2ToBe_obs" name="Escreve a observação do período">
      <bpmn:incoming>Flow_P2ToBe_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P2ToBe_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P2ToBe_obsfim" name="Observação aparece no relatório">
      <bpmn:incoming>Flow_P2ToBe_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P2ToBe_1" sourceRef="P2ToBe_ini" targetRef="P2ToBe_entra" />
    <bpmn:sequenceFlow id="Flow_P2ToBe_2" sourceRef="P2ToBe_entra" targetRef="P2ToBe_semana" />
    <bpmn:sequenceFlow id="Flow_P2ToBe_3" sourceRef="P2ToBe_semana" targetRef="P2ToBe_quer" />
    <bpmn:sequenceFlow id="Flow_P2ToBe_4" name="Não" sourceRef="P2ToBe_quer" targetRef="P2ToBe_infsemana" />
    <bpmn:sequenceFlow id="Flow_P2ToBe_5" name="Sim" sourceRef="P2ToBe_quer" targetRef="P2ToBe_monta" />
    <bpmn:sequenceFlow id="Flow_P2ToBe_6" sourceRef="P2ToBe_monta" targetRef="P2ToBe_le" />
    <bpmn:sequenceFlow id="Flow_P2ToBe_7" sourceRef="P2ToBe_le" targetRef="P2ToBe_atenc" />
    <bpmn:sequenceFlow id="Flow_P2ToBe_8" name="Sim" sourceRef="P2ToBe_atenc" targetRef="P2ToBe_age" />
    <bpmn:sequenceFlow id="Flow_P2ToBe_9" name="Não" sourceRef="P2ToBe_atenc" targetRef="P2ToBe_emdia" />
    <bpmn:sequenceFlow id="Flow_P2ToBe_10" sourceRef="P2ToBe_age" targetRef="P2ToBe_fim" />
    <bpmn:sequenceFlow id="Flow_P2ToBe_11" sourceRef="P2ToBe_periodo" targetRef="P2ToBe_obs" />
    <bpmn:sequenceFlow id="Flow_P2ToBe_12" sourceRef="P2ToBe_obs" targetRef="P2ToBe_obsfim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P2ToBe">
    <bpmndi:BPMNPlane id="Plane_P2ToBe" bpmnElement="Collaboration_P2ToBe">
      <bpmndi:BPMNShape id="Participant_P2ToBe_di" bpmnElement="Participant_P2ToBe" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1388" height="560" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_Lane_R_di" bpmnElement="P2ToBe_Lane_R" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1358" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_Lane_S_di" bpmnElement="P2ToBe_Lane_S" isHorizontal="true">
        <dc:Bounds x="150" y="320" width="1358" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_Lane_P_di" bpmnElement="P2ToBe_Lane_P" isHorizontal="true">
        <dc:Bounds x="150" y="480" width="1358" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_ini_di" bpmnElement="P2ToBe_ini">
        <dc:Bounds x="202" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="170" y="222" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_entra_di" bpmnElement="P2ToBe_entra">
        <dc:Bounds x="290" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_semana_di" bpmnElement="P2ToBe_semana">
        <dc:Bounds x="440" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_quer_di" bpmnElement="P2ToBe_quer" isMarkerVisible="true">
        <dc:Bounds x="615" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="509" y="186" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_infsemana_di" bpmnElement="P2ToBe_infsemana">
        <dc:Bounds x="742" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="784" y="126" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_monta_di" bpmnElement="P2ToBe_monta">
        <dc:Bounds x="760" y="360" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_le_di" bpmnElement="P2ToBe_le">
        <dc:Bounds x="910" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_atenc_di" bpmnElement="P2ToBe_atenc" isMarkerVisible="true">
        <dc:Bounds x="1085" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1060" y="131" width="100" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_age_di" bpmnElement="P2ToBe_age">
        <dc:Bounds x="1190" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_fim_di" bpmnElement="P2ToBe_fim">
        <dc:Bounds x="1372" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1340" y="222" width="100" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_emdia_di" bpmnElement="P2ToBe_emdia">
        <dc:Bounds x="1232" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1274" y="256" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_periodo_di" bpmnElement="P2ToBe_periodo">
        <dc:Bounds x="202" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="170" y="582" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_obs_di" bpmnElement="P2ToBe_obs">
        <dc:Bounds x="290" y="520" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2ToBe_obsfim_di" bpmnElement="P2ToBe_obsfim">
        <dc:Bounds x="482" y="542" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="450" y="582" width="100" height="42" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_1_di" bpmnElement="Flow_P2ToBe_1">
        <di:waypoint x="238" y="200" />
        <di:waypoint x="290" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_2_di" bpmnElement="Flow_P2ToBe_2">
        <di:waypoint x="410" y="200" />
        <di:waypoint x="425" y="200" />
        <di:waypoint x="425" y="400" />
        <di:waypoint x="440" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_3_di" bpmnElement="Flow_P2ToBe_3">
        <di:waypoint x="560" y="400" />
        <di:waypoint x="640" y="400" />
        <di:waypoint x="640" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_4_di" bpmnElement="Flow_P2ToBe_4">
        <di:waypoint x="640" y="175" />
        <di:waypoint x="640" y="140" />
        <di:waypoint x="742" y="140" />
        <bpmndi:BPMNLabel><dc:Bounds x="646" y="157" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_5_di" bpmnElement="Flow_P2ToBe_5">
        <di:waypoint x="665" y="200" />
        <di:waypoint x="700" y="200" />
        <di:waypoint x="700" y="400" />
        <di:waypoint x="760" y="400" />
        <bpmndi:BPMNLabel><dc:Bounds x="671" y="182" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_6_di" bpmnElement="Flow_P2ToBe_6">
        <di:waypoint x="880" y="400" />
        <di:waypoint x="895" y="400" />
        <di:waypoint x="895" y="200" />
        <di:waypoint x="910" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_7_di" bpmnElement="Flow_P2ToBe_7">
        <di:waypoint x="1030" y="200" />
        <di:waypoint x="1085" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_8_di" bpmnElement="Flow_P2ToBe_8">
        <di:waypoint x="1135" y="200" />
        <di:waypoint x="1190" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="1141" y="182" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_9_di" bpmnElement="Flow_P2ToBe_9">
        <di:waypoint x="1110" y="225" />
        <di:waypoint x="1110" y="270" />
        <di:waypoint x="1232" y="270" />
        <bpmndi:BPMNLabel><dc:Bounds x="1116" y="227" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_10_di" bpmnElement="Flow_P2ToBe_10">
        <di:waypoint x="1310" y="200" />
        <di:waypoint x="1372" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_11_di" bpmnElement="Flow_P2ToBe_11">
        <di:waypoint x="238" y="560" />
        <di:waypoint x="290" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2ToBe_12_di" bpmnElement="Flow_P2ToBe_12">
        <di:waypoint x="410" y="560" />
        <di:waypoint x="482" y="560" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
