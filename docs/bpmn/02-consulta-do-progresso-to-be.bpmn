<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_P07ToBe" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_P07ToBe">
    <bpmn:participant id="Participant_P07ToBe" name="2. Consulta do progresso pelo responsável (TO-BE)" processRef="Process_P07ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P07ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P07ToBe">
      <bpmn:lane id="P07ToBe_Lane_R" name="Responsável">
        <bpmn:flowNodeRef>P07ToBe_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_escolhe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_consulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_quer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_rnao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_le</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07ToBe_Lane_S" name="Sistema Acompanha">
        <bpmn:flowNodeRef>P07ToBe_vinc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_negado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_varios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_lista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_semana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_monta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07ToBe_Lane_P" name="Professora">
        <bpmn:flowNodeRef>P07ToBe_pini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_obs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07ToBe_pfim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P07ToBe_ini" name="Quer saber como o filho está">
      <bpmn:outgoing>Flow_P07ToBe_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P07ToBe_login" name="Faz login com e-mail e senha">
      <bpmn:incoming>Flow_P07ToBe_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P07ToBe_vinc" name="Vínculo ativo com algum aluno?">
      <bpmn:incoming>Flow_P07ToBe_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07ToBe_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P07ToBe_negado" name="Acesso negado e registrado">
      <bpmn:incoming>Flow_P07ToBe_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P07ToBe_varios" name="Mais de um aluno vinculado?">
      <bpmn:incoming>Flow_P07ToBe_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07ToBe_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P07ToBe_lista" name="Lista os alunos vinculados">
      <bpmn:incoming>Flow_P07ToBe_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P07ToBe_escolhe" name="Escolhe o aluno">
      <bpmn:incoming>Flow_P07ToBe_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P07ToBe_merge">
      <bpmn:incoming>Flow_P07ToBe_6</bpmn:incoming>
      <bpmn:incoming>Flow_P07ToBe_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P07ToBe_semana" name="Mostra a semana: última aula, tarefas e provas">
      <bpmn:incoming>Flow_P07ToBe_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P07ToBe_consulta" name="Consulta a semana do filho">
      <bpmn:incoming>Flow_P07ToBe_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P07ToBe_quer" name="Quer ver o relatório do período?">
      <bpmn:incoming>Flow_P07ToBe_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07ToBe_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P07ToBe_rnao" name="Informado sobre a semana">
      <bpmn:incoming>Flow_P07ToBe_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P07ToBe_monta" name="Monta o relatório do mês ou bimestre">
      <bpmn:incoming>Flow_P07ToBe_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P07ToBe_le" name="Lê o relatório de progresso">
      <bpmn:incoming>Flow_P07ToBe_14</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P07ToBe_fim" name="Informado">
      <bpmn:incoming>Flow_P07ToBe_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P07ToBe_pini" name="Fim do mês ou do bimestre">
      <bpmn:outgoing>Flow_P07ToBe_16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_P07ToBe_pini" />
    </bpmn:startEvent>
    <bpmn:userTask id="P07ToBe_obs" name="Escreve a observação pedagógica do período">
      <bpmn:incoming>Flow_P07ToBe_16</bpmn:incoming>
      <bpmn:outgoing>Flow_P07ToBe_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P07ToBe_pfim" name="Observação disponível no relatório">
      <bpmn:incoming>Flow_P07ToBe_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P07ToBe_1" sourceRef="P07ToBe_ini" targetRef="P07ToBe_login" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_2" sourceRef="P07ToBe_login" targetRef="P07ToBe_vinc" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_3" name="Não" sourceRef="P07ToBe_vinc" targetRef="P07ToBe_negado" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_4" name="Sim" sourceRef="P07ToBe_vinc" targetRef="P07ToBe_varios" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_5" name="Sim" sourceRef="P07ToBe_varios" targetRef="P07ToBe_lista" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_6" name="Não" sourceRef="P07ToBe_varios" targetRef="P07ToBe_merge" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_7" sourceRef="P07ToBe_lista" targetRef="P07ToBe_escolhe" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_8" sourceRef="P07ToBe_escolhe" targetRef="P07ToBe_merge" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_9" sourceRef="P07ToBe_merge" targetRef="P07ToBe_semana" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_10" sourceRef="P07ToBe_semana" targetRef="P07ToBe_consulta" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_11" sourceRef="P07ToBe_consulta" targetRef="P07ToBe_quer" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_12" name="Sim" sourceRef="P07ToBe_quer" targetRef="P07ToBe_monta" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_13" name="Não" sourceRef="P07ToBe_quer" targetRef="P07ToBe_rnao" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_14" sourceRef="P07ToBe_monta" targetRef="P07ToBe_le" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_15" sourceRef="P07ToBe_le" targetRef="P07ToBe_fim" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_16" sourceRef="P07ToBe_pini" targetRef="P07ToBe_obs" />
    <bpmn:sequenceFlow id="Flow_P07ToBe_17" sourceRef="P07ToBe_obs" targetRef="P07ToBe_pfim" />
  </bpmn:process>
