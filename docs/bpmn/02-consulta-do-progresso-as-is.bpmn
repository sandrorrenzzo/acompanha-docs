<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P2AsIs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.0.0">
  <bpmn:collaboration id="Collaboration_P2AsIs">
    <bpmn:participant id="Participant_P2AsIs" name="2. Consulta do progresso pelo responsável (AS-IS)" processRef="Process_P2AsIs" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P2AsIs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P2AsIs">
      <bpmn:lane id="P2AsIs_Lane_R" name="Responsável">
        <bpmn:flowNodeRef>P2AsIs_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2AsIs_pergunta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2AsIs_recebe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2AsIs_fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2AsIs_Lane_P" name="Professora">
        <bpmn:flowNodeRef>P2AsIs_livre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2AsIs_espera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2AsIs_m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2AsIs_responde</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2AsIs_ini" name="Quer saber como o filho está">
      <bpmn:outgoing>Flow_P2AsIs_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="P2AsIs_pergunta" name="Pergunta por WhatsApp ou pessoalmente">
      <bpmn:incoming>Flow_P2AsIs_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P2AsIs_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="P2AsIs_livre" name="Está livre para responder?">
      <bpmn:incoming>Flow_P2AsIs_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P2AsIs_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_P2AsIs_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="P2AsIs_espera" name="Fim da aula ou do dia">
      <bpmn:incoming>Flow_P2AsIs_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P2AsIs_5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_P2AsIs_espera" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P2AsIs_m">
      <bpmn:incoming>Flow_P2AsIs_3</bpmn:incoming>
      <bpmn:incoming>Flow_P2AsIs_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P2AsIs_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="P2AsIs_responde" name="Responde com o que lembra">
      <bpmn:incoming>Flow_P2AsIs_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P2AsIs_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P2AsIs_recebe" name="Recebe a resposta">
      <bpmn:incoming>Flow_P2AsIs_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P2AsIs_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="P2AsIs_fim" name="Sabe só o que perguntou">
      <bpmn:incoming>Flow_P2AsIs_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P2AsIs_1" sourceRef="P2AsIs_ini" targetRef="P2AsIs_pergunta" />
    <bpmn:sequenceFlow id="Flow_P2AsIs_2" sourceRef="P2AsIs_pergunta" targetRef="P2AsIs_livre" />
    <bpmn:sequenceFlow id="Flow_P2AsIs_3" name="Sim" sourceRef="P2AsIs_livre" targetRef="P2AsIs_m" />
    <bpmn:sequenceFlow id="Flow_P2AsIs_4" name="Não" sourceRef="P2AsIs_livre" targetRef="P2AsIs_espera" />
    <bpmn:sequenceFlow id="Flow_P2AsIs_5" sourceRef="P2AsIs_espera" targetRef="P2AsIs_m" />
    <bpmn:sequenceFlow id="Flow_P2AsIs_6" sourceRef="P2AsIs_m" targetRef="P2AsIs_responde" />
    <bpmn:sequenceFlow id="Flow_P2AsIs_7" sourceRef="P2AsIs_responde" targetRef="P2AsIs_recebe" />
    <bpmn:sequenceFlow id="Flow_P2AsIs_8" sourceRef="P2AsIs_recebe" targetRef="P2AsIs_fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P2AsIs">
    <bpmndi:BPMNPlane id="Plane_P2AsIs" bpmnElement="Collaboration_P2AsIs">
      <bpmndi:BPMNShape id="Participant_P2AsIs_di" bpmnElement="Participant_P2AsIs" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1078" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2AsIs_Lane_R_di" bpmnElement="P2AsIs_Lane_R" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1048" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2AsIs_Lane_P_di" bpmnElement="P2AsIs_Lane_P" isHorizontal="true">
        <dc:Bounds x="150" y="240" width="1048" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2AsIs_ini_di" bpmnElement="P2AsIs_ini">
        <dc:Bounds x="202" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="170" y="182" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2AsIs_pergunta_di" bpmnElement="P2AsIs_pergunta">
        <dc:Bounds x="290" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2AsIs_livre_di" bpmnElement="P2AsIs_livre" isMarkerVisible="true">
        <dc:Bounds x="475" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="369" y="346" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2AsIs_espera_di" bpmnElement="P2AsIs_espera">
        <dc:Bounds x="582" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="550" y="452" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2AsIs_m_di" bpmnElement="P2AsIs_m" isMarkerVisible="true">
        <dc:Bounds x="655" y="335" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2AsIs_responde_di" bpmnElement="P2AsIs_responde">
        <dc:Bounds x="740" y="320" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2AsIs_recebe_di" bpmnElement="P2AsIs_recebe">
        <dc:Bounds x="890" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2AsIs_fim_di" bpmnElement="P2AsIs_fim">
        <dc:Bounds x="1062" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1030" y="182" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_P2AsIs_1_di" bpmnElement="Flow_P2AsIs_1">
        <di:waypoint x="238" y="160" />
        <di:waypoint x="290" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2AsIs_2_di" bpmnElement="Flow_P2AsIs_2">
        <di:waypoint x="410" y="160" />
        <di:waypoint x="500" y="160" />
        <di:waypoint x="500" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2AsIs_3_di" bpmnElement="Flow_P2AsIs_3">
        <di:waypoint x="525" y="360" />
        <di:waypoint x="655" y="360" />
        <bpmndi:BPMNLabel><dc:Bounds x="531" y="342" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2AsIs_4_di" bpmnElement="Flow_P2AsIs_4">
        <di:waypoint x="500" y="385" />
        <di:waypoint x="500" y="430" />
        <di:waypoint x="582" y="430" />
        <bpmndi:BPMNLabel><dc:Bounds x="506" y="387" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2AsIs_5_di" bpmnElement="Flow_P2AsIs_5">
        <di:waypoint x="618" y="430" />
        <di:waypoint x="680" y="430" />
        <di:waypoint x="680" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2AsIs_6_di" bpmnElement="Flow_P2AsIs_6">
        <di:waypoint x="705" y="360" />
        <di:waypoint x="740" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2AsIs_7_di" bpmnElement="Flow_P2AsIs_7">
        <di:waypoint x="860" y="360" />
        <di:waypoint x="875" y="360" />
        <di:waypoint x="875" y="160" />
        <di:waypoint x="890" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2AsIs_8_di" bpmnElement="Flow_P2AsIs_8">
        <di:waypoint x="1010" y="160" />
        <di:waypoint x="1062" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
