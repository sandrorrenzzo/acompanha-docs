<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_P07AsIs" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_P07AsIs">
    <bpmn:participant id="Participant_P07AsIs" name="2. Consulta do progresso pelo responsável (AS-IS)" processRef="Process_P07AsIs" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P07AsIs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P07AsIs">
      <bpmn:lane id="P07AsIs_Lane_R" name="Responsável">
        <bpmn:flowNodeRef>P07AsIs_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07AsIs_pergunta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07AsIs_recebe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07AsIs_fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07AsIs_Lane_P" name="Professora">
        <bpmn:flowNodeRef>P07AsIs_lembra</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P07AsIs_ini" name="Quer saber como o filho está">
      <bpmn:outgoing>Flow_P07AsIs_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="P07AsIs_pergunta" name="Pergunta por WhatsApp ou pessoalmente">
      <bpmn:incoming>Flow_P07AsIs_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P07AsIs_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P07AsIs_lembra" name="Responde de memória, sem registro para consultar">
      <bpmn:incoming>Flow_P07AsIs_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P07AsIs_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P07AsIs_recebe" name="Recebe a resposta">
      <bpmn:incoming>Flow_P07AsIs_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P07AsIs_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="P07AsIs_fim" name="Informado">
      <bpmn:incoming>Flow_P07AsIs_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P07AsIs_1" sourceRef="P07AsIs_ini" targetRef="P07AsIs_pergunta" />
    <bpmn:sequenceFlow id="Flow_P07AsIs_2" sourceRef="P07AsIs_pergunta" targetRef="P07AsIs_lembra" />
    <bpmn:sequenceFlow id="Flow_P07AsIs_3" sourceRef="P07AsIs_lembra" targetRef="P07AsIs_recebe" />
    <bpmn:sequenceFlow id="Flow_P07AsIs_4" sourceRef="P07AsIs_recebe" targetRef="P07AsIs_fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P07AsIs">
    <bpmndi:BPMNPlane id="BPMNPlane_P07AsIs" bpmnElement="Collaboration_P07AsIs">
      <bpmndi:BPMNShape id="Participant_P07AsIs_di" bpmnElement="Participant_P07AsIs" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="920" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07AsIs_Lane_R_di" bpmnElement="P07AsIs_Lane_R" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="890" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07AsIs_Lane_P_di" bpmnElement="P07AsIs_Lane_P" isHorizontal="true">
        <dc:Bounds x="190" y="220" width="890" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07AsIs_ini_di" bpmnElement="P07AsIs_ini">
        <dc:Bounds x="287" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07AsIs_pergunta_di" bpmnElement="P07AsIs_pergunta">
        <dc:Bounds x="415" y="105" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07AsIs_lembra_di" bpmnElement="P07AsIs_lembra">
        <dc:Bounds x="585" y="245" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07AsIs_recebe_di" bpmnElement="P07AsIs_recebe">
        <dc:Bounds x="755" y="105" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P07AsIs_fim_di" bpmnElement="P07AsIs_fim">
        <dc:Bounds x="967" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_P07AsIs_1_di" bpmnElement="Flow_P07AsIs_1">
        <di:waypoint x="323" y="150" />
        <di:waypoint x="415" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P07AsIs_2_di" bpmnElement="Flow_P07AsIs_2">
        <di:waypoint x="535" y="150" />
        <di:waypoint x="560" y="150" />
        <di:waypoint x="560" y="290" />
        <di:waypoint x="585" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P07AsIs_3_di" bpmnElement="Flow_P07AsIs_3">
        <di:waypoint x="705" y="290" />
        <di:waypoint x="730" y="290" />
        <di:waypoint x="730" y="150" />
        <di:waypoint x="755" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P07AsIs_4_di" bpmnElement="Flow_P07AsIs_4">
        <di:waypoint x="875" y="150" />
        <di:waypoint x="967" y="150" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
