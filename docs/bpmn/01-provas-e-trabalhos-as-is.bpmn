        <bpmndi:BPMNLabel>
          <dc:Bounds x="415" y="81" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05AsIs_nsabe_di" bpmnElement="P05AsIs_nsabe">
