          <dc:Bounds x="925" y="81" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05AsIs_nnota_di" bpmnElement="P05AsIs_nnota">
