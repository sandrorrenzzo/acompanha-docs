      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05AsIs_olha_di" bpmnElement="P05AsIs_olha">
        <dc:Bounds x="1095" y="385" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05AsIs_ruim_di" bpmnElement="P05AsIs_ruim" isMarkerVisible="true">
        <dc:Bounds x="1300" y="405" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1265" y="361" width="120" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05AsIs_ok_di" bpmnElement="P05AsIs_ok">
        <dc:Bounds x="1307" y="552" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05AsIs_avisa_di" bpmnElement="P05AsIs_avisa">
        <dc:Bounds x="1435" y="385" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05AsIs_ouve_di" bpmnElement="P05AsIs_ouve">
        <dc:Bounds x="1605" y="665" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05AsIs_rfim_di" bpmnElement="P05AsIs_rfim">
        <dc:Bounds x="1817" y="692" width="36" height="36" />
      </bpmndi:BPMNShape>
