<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P1ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.0.0">
  <bpmn:collaboration id="Collaboration_P1ToBe">
    <bpmn:participant id="Participant_P1ToBe" name="1. Provas e trabalhos do colégio (TO-BE)" processRef="Process_P1ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P1ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P1ToBe">
      <bpmn:lane id="P1ToBe_Lane_A" name="Aluno">
        <bpmn:flowNodeRef>P1ToBe_faz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_nota</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1ToBe_Lane_P" name="Professora">
        <bpmn:flowNodeRef>P1ToBe_entra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_pede</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_cad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_estuda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_dia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_lanca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_elogio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_parabeniza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_avisabom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_segue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_entende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_conversa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_planeja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1ToBe_Lane_S" name="Sistema Acompanha">
        <bpmn:flowNodeRef>P1ToBe_mostra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_recalc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_abaixo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1ToBe_sinaliza</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1ToBe_Lane_R" name="Responsável">
        <bpmn:flowNodeRef>P1ToBe_manda</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1ToBe_entra" name="Aluno entra na escolinha">
      <bpmn:outgoing>Flow_P1ToBe_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="P1ToBe_pede" name="Pede o cronograma de provas no WhatsApp">
      <bpmn:incoming>Flow_P1ToBe_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P1ToBe_manda" name="Manda o cronograma">
      <bpmn:incoming>Flow_P1ToBe_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P1ToBe_cad" name="Cadastra as provas no sistema">
      <bpmn:incoming>Flow_P1ToBe_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P1ToBe_mostra" name="Mostra no painel e ao responsável">
      <bpmn:incoming>Flow_P1ToBe_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P1ToBe_estuda" name="Estuda com o aluno para a prova">
      <bpmn:incoming>Flow_P1ToBe_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="P1ToBe_dia" name="Dia da prova">
      <bpmn:incoming>Flow_P1ToBe_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_P1ToBe_dia" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="P1ToBe_faz" name="Faz a prova">
      <bpmn:incoming>Flow_P1ToBe_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P1ToBe_nota" name="Recebe a nota e mostra à professora">
      <bpmn:incoming>Flow_P1ToBe_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P1ToBe_lanca" name="Lança a nota">
      <bpmn:incoming>Flow_P1ToBe_9</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P1ToBe_recalc" name="Compara com o esperado pela escola">
      <bpmn:incoming>Flow_P1ToBe_10</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P1ToBe_abaixo" name="Abaixo do esperado pela escola?">
      <bpmn:incoming>Flow_P1ToBe_11</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_P1ToBe_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P1ToBe_elogio" name="Registra o elogio no sistema">
      <bpmn:incoming>Flow_P1ToBe_12</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="P1ToBe_parabeniza" name="Parabeniza o aluno">
      <bpmn:incoming>Flow_P1ToBe_13</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P1ToBe_avisabom" name="Avisa os pais">
      <bpmn:incoming>Flow_P1ToBe_14</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="P1ToBe_segue" name="Pais avisados, com registro">
      <bpmn:incoming>Flow_P1ToBe_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P1ToBe_sinaliza" name="Sinaliza reforço na matéria">
      <bpmn:incoming>Flow_P1ToBe_16</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P1ToBe_entende" name="Procura entender por que foi mal">
      <bpmn:incoming>Flow_P1ToBe_17</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P1ToBe_conversa" name="Conversa com os pais">
      <bpmn:incoming>Flow_P1ToBe_18</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P1ToBe_planeja" name="Passa atividades de reforço">
      <bpmn:incoming>Flow_P1ToBe_19</bpmn:incoming>
      <bpmn:outgoing>Flow_P1ToBe_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P1ToBe_fim" name="Aluno em reforço, com registro">
      <bpmn:incoming>Flow_P1ToBe_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P1ToBe_1" sourceRef="P1ToBe_entra" targetRef="P1ToBe_pede" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_2" sourceRef="P1ToBe_pede" targetRef="P1ToBe_manda" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_3" sourceRef="P1ToBe_manda" targetRef="P1ToBe_cad" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_4" sourceRef="P1ToBe_cad" targetRef="P1ToBe_mostra" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_5" sourceRef="P1ToBe_mostra" targetRef="P1ToBe_estuda" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_6" sourceRef="P1ToBe_estuda" targetRef="P1ToBe_dia" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_7" sourceRef="P1ToBe_dia" targetRef="P1ToBe_faz" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_8" sourceRef="P1ToBe_faz" targetRef="P1ToBe_nota" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_9" sourceRef="P1ToBe_nota" targetRef="P1ToBe_lanca" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_10" sourceRef="P1ToBe_lanca" targetRef="P1ToBe_recalc" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_11" sourceRef="P1ToBe_recalc" targetRef="P1ToBe_abaixo" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_12" name="Não" sourceRef="P1ToBe_abaixo" targetRef="P1ToBe_elogio" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_13" sourceRef="P1ToBe_elogio" targetRef="P1ToBe_parabeniza" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_14" sourceRef="P1ToBe_parabeniza" targetRef="P1ToBe_avisabom" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_15" sourceRef="P1ToBe_avisabom" targetRef="P1ToBe_segue" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_16" name="Sim" sourceRef="P1ToBe_abaixo" targetRef="P1ToBe_sinaliza" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_17" sourceRef="P1ToBe_sinaliza" targetRef="P1ToBe_entende" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_18" sourceRef="P1ToBe_entende" targetRef="P1ToBe_conversa" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_19" sourceRef="P1ToBe_conversa" targetRef="P1ToBe_planeja" />
    <bpmn:sequenceFlow id="Flow_P1ToBe_20" sourceRef="P1ToBe_planeja" targetRef="P1ToBe_fim" />
  </bpmn:process>
