<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_P05ToBe" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_P05ToBe">
    <bpmn:participant id="Participant_P05ToBe" name="1. Provas e trabalhos do colégio (TO-BE)" processRef="Process_P05ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P05ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P05ToBe">
      <bpmn:lane id="P05ToBe_Lane_P" name="Professora">
        <bpmn:flowNodeRef>P05ToBe_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05ToBe_cad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05ToBe_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05ToBe_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05ToBe_obtem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05ToBe_lanca</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P05ToBe_Lane_S" name="Sistema Acompanha">
        <bpmn:flowNodeRef>P05ToBe_mostra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05ToBe_salva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05ToBe_reforco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05ToBe_fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P05ToBe_ini" name="Fica sabendo de uma prova ou trabalho">
      <bpmn:outgoing>Flow_P05ToBe_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P05ToBe_cad" name="Cadastra com matéria, origem e data, sem nota">
      <bpmn:incoming>Flow_P05ToBe_1</bpmn:incoming>
      <bpmn:outgoing>Flow_P05ToBe_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P05ToBe_mostra" name="Mostra no painel e na semana do responsável">
      <bpmn:incoming>Flow_P05ToBe_2</bpmn:incoming>
      <bpmn:outgoing>Flow_P05ToBe_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P05ToBe_prep" name="Ajuda o aluno a se preparar">
      <bpmn:incoming>Flow_P05ToBe_3</bpmn:incoming>
      <bpmn:outgoing>Flow_P05ToBe_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="P05ToBe_data" name="Data da prova ou da entrega">
      <bpmn:incoming>Flow_P05ToBe_4</bpmn:incoming>
      <bpmn:outgoing>Flow_P05ToBe_5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_P05ToBe_data" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="P05ToBe_obtem" name="Corrige ou recebe a nota do colégio">
      <bpmn:incoming>Flow_P05ToBe_5</bpmn:incoming>
      <bpmn:outgoing>Flow_P05ToBe_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P05ToBe_lanca" name="Lança a nota">
      <bpmn:incoming>Flow_P05ToBe_6</bpmn:incoming>
      <bpmn:outgoing>Flow_P05ToBe_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P05ToBe_salva" name="Salva a nota e recalcula a média da matéria">
      <bpmn:incoming>Flow_P05ToBe_7</bpmn:incoming>
      <bpmn:outgoing>Flow_P05ToBe_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P05ToBe_reforco" name="Sinaliza reforço se a média ficar abaixo de 6,0">
      <bpmn:incoming>Flow_P05ToBe_8</bpmn:incoming>
      <bpmn:outgoing>Flow_P05ToBe_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P05ToBe_fim" name="Nota registrada">
      <bpmn:incoming>Flow_P05ToBe_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P05ToBe_1" sourceRef="P05ToBe_ini" targetRef="P05ToBe_cad" />
    <bpmn:sequenceFlow id="Flow_P05ToBe_2" sourceRef="P05ToBe_cad" targetRef="P05ToBe_mostra" />
    <bpmn:sequenceFlow id="Flow_P05ToBe_3" sourceRef="P05ToBe_mostra" targetRef="P05ToBe_prep" />
    <bpmn:sequenceFlow id="Flow_P05ToBe_4" sourceRef="P05ToBe_prep" targetRef="P05ToBe_data" />
    <bpmn:sequenceFlow id="Flow_P05ToBe_5" sourceRef="P05ToBe_data" targetRef="P05ToBe_obtem" />
    <bpmn:sequenceFlow id="Flow_P05ToBe_6" sourceRef="P05ToBe_obtem" targetRef="P05ToBe_lanca" />
    <bpmn:sequenceFlow id="Flow_P05ToBe_7" sourceRef="P05ToBe_lanca" targetRef="P05ToBe_salva" />
    <bpmn:sequenceFlow id="Flow_P05ToBe_8" sourceRef="P05ToBe_salva" targetRef="P05ToBe_reforco" />
    <bpmn:sequenceFlow id="Flow_P05ToBe_9" sourceRef="P05ToBe_reforco" targetRef="P05ToBe_fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P05ToBe">
    <bpmndi:BPMNPlane id="BPMNPlane_P05ToBe" bpmnElement="Collaboration_P05ToBe">
      <bpmndi:BPMNShape id="Participant_P05ToBe_di" bpmnElement="Participant_P05ToBe" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1810" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_Lane_P_di" bpmnElement="P05ToBe_Lane_P" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1780" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_Lane_S_di" bpmnElement="P05ToBe_Lane_S" isHorizontal="true">
        <dc:Bounds x="190" y="220" width="1780" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_ini_di" bpmnElement="P05ToBe_ini">
        <dc:Bounds x="287" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_cad_di" bpmnElement="P05ToBe_cad">
        <dc:Bounds x="415" y="105" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_mostra_di" bpmnElement="P05ToBe_mostra">
        <dc:Bounds x="585" y="245" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_prep_di" bpmnElement="P05ToBe_prep">
        <dc:Bounds x="755" y="105" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_data_di" bpmnElement="P05ToBe_data">
        <dc:Bounds x="967" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_obtem_di" bpmnElement="P05ToBe_obtem">
        <dc:Bounds x="1095" y="105" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_lanca_di" bpmnElement="P05ToBe_lanca">
        <dc:Bounds x="1265" y="105" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_salva_di" bpmnElement="P05ToBe_salva">
        <dc:Bounds x="1470" y="245" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_reforco_di" bpmnElement="P05ToBe_reforco">
        <dc:Bounds x="1640" y="245" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P05ToBe_fim_di" bpmnElement="P05ToBe_fim">
        <dc:Bounds x="1852" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_P05ToBe_1_di" bpmnElement="Flow_P05ToBe_1">
        <di:waypoint x="323" y="150" />
        <di:waypoint x="415" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P05ToBe_2_di" bpmnElement="Flow_P05ToBe_2">
        <di:waypoint x="535" y="150" />
        <di:waypoint x="560" y="150" />
        <di:waypoint x="560" y="290" />
        <di:waypoint x="585" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P05ToBe_3_di" bpmnElement="Flow_P05ToBe_3">
        <di:waypoint x="705" y="290" />
        <di:waypoint x="730" y="290" />
        <di:waypoint x="730" y="150" />
        <di:waypoint x="755" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P05ToBe_4_di" bpmnElement="Flow_P05ToBe_4">
        <di:waypoint x="875" y="150" />
        <di:waypoint x="967" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P05ToBe_5_di" bpmnElement="Flow_P05ToBe_5">
        <di:waypoint x="1003" y="150" />
        <di:waypoint x="1095" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P05ToBe_6_di" bpmnElement="Flow_P05ToBe_6">
        <di:waypoint x="1215" y="150" />
        <di:waypoint x="1265" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P05ToBe_7_di" bpmnElement="Flow_P05ToBe_7">
        <di:waypoint x="1385" y="150" />
        <di:waypoint x="1427" y="150" />
        <di:waypoint x="1427" y="290" />
        <di:waypoint x="1470" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P05ToBe_8_di" bpmnElement="Flow_P05ToBe_8">
        <di:waypoint x="1590" y="290" />
        <di:waypoint x="1640" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P05ToBe_9_di" bpmnElement="Flow_P05ToBe_9">
        <di:waypoint x="1760" y="290" />
        <di:waypoint x="1852" y="290" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
